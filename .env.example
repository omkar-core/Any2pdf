# Google AI (Gemini) API key — used by the Genkit flows in src/ai/
# Get one at https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=

# n8n webhook that orchestrates file conversions
# (if unset, the hard-coded default in src/app/actions.ts is used)
N8N_WEBHOOK_URL=https://nickjamerstudio.app.n8n.cloud/webhook/Any2PDF

# Optional: Firebase config for authentication, storage, and Firestore
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: Google Analytics 4 measurement ID (loads the gtag snippet on all pages)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: Stripe subscription checkout
# STRIPE_PRICE_ID is the recurring price ID for the Pro plan (e.g. price_xxxx)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Public origin used to build Stripe success/cancel URLs
# (set to your deployed domain in production, e.g. https://any2pdf.com)
NEXT_PUBLIC_APP_URL=